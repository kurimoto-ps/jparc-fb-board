(version 1)

# Preserve existing MCU/SDRAM escape vias; general vias use 0.45/0.20 mm.
(rule "General via size"
 (condition "A.Type == 'Via' && !A.intersectsArea('MAX10_BGA_ESCAPE') && !A.intersectsArea('STM_BGA_ESCAPE') && !A.intersectsArea('SDRAM_BGA_ESCAPE') && !(A.NetName == '/Interface Sheet/ACC_TRIG' || A.NetName == '/Interface Sheet/GPIO0' || A.NetName == '/Interface Sheet/GPIO1' || A.NetName == '/Interface Sheet/GPIO10' || A.NetName == '/Interface Sheet/GPIO11' || A.NetName == '/Interface Sheet/GPIO12' || A.NetName == '/Interface Sheet/GPIO13' || A.NetName == '/Interface Sheet/GPIO14' || A.NetName == '/Interface Sheet/GPIO15' || A.NetName == '/Interface Sheet/GPIO16' || A.NetName == '/Interface Sheet/GPIO17' || A.NetName == '/Interface Sheet/GPIO18' || A.NetName == '/Interface Sheet/GPIO19' || A.NetName == '/Interface Sheet/GPIO2' || A.NetName == '/Interface Sheet/GPIO20' || A.NetName == '/Interface Sheet/GPIO21' || A.NetName == '/Interface Sheet/GPIO22' || A.NetName == '/Interface Sheet/GPIO23' || A.NetName == '/Interface Sheet/GPIO24' || A.NetName == '/Interface Sheet/GPIO25' || A.NetName == '/Interface Sheet/GPIO26' || A.NetName == '/Interface Sheet/GPIO27' || A.NetName == '/Interface Sheet/GPIO28' || A.NetName == '/Interface Sheet/GPIO29' || A.NetName == '/Interface Sheet/GPIO3' || A.NetName == '/Interface Sheet/GPIO30' || A.NetName == '/Interface Sheet/GPIO31' || A.NetName == '/Interface Sheet/GPIO4' || A.NetName == '/Interface Sheet/GPIO5' || A.NetName == '/Interface Sheet/GPIO6' || A.NetName == '/Interface Sheet/GPIO7' || A.NetName == '/Interface Sheet/GPIO8' || A.NetName == '/Interface Sheet/GPIO9' || A.NetName == '/Interface Sheet/R2_UART' || A.NetName == '/Interface Sheet/T2_UART' || A.NetName == '/MAX10 Sheet/GPIO_RSRV0' || A.NetName == '/MAX10 Sheet/GPIO_RSRV1' || A.NetName == '/MAX10 Sheet/GPIO_RSRV2' || A.NetName == '/MAX10 Sheet/GPIO_RSRV3' || A.NetName == '/MAX10 Sheet/GPIO_RSRV4' || A.NetName == '/MAX10 Sheet/GPIO_RSRV5' || A.NetName == '/MAX10 Sheet/GPIO_RSRV6' || A.NetName == '/MAX10 Sheet/GPIO_RSRV7' || A.NetName == '/MAX10 Sheet/MAX10_FAULT' || A.NetName == '/MAX10 Sheet/MAX10_IRQ' || A.NetName == '/MAX10 Sheet/MAX10_READY' || A.NetName == '/MAX10 Sheet/MCU_HEARTBEAT' || A.NetName == '/MAX10 Sheet/SPI1_NSS' || A.NetName == '/MAX10 Sheet/SPI2_MOSI' || A.NetName == '/MAX10 Sheet/SPI2_NSS' || A.NetName == '/MAX10 Sheet/SPI2_SCLK' || A.NetName == '/MAX10 Sheet/SPI3_MOSI' || A.NetName == '/MAX10 Sheet/SPI3_NSS' || A.NetName == '/MAX10 Sheet/SPI4_NSS' || A.NetName == '/MAX10 Sheet/SPI4_SCLK' || A.NetName == '/MAX10 Sheet/XCONFDONE' || A.NetName == '/MAX10 Sheet/XNCONFIG' || A.NetName == '/MAX10 Sheet/XNSTATUS' || A.NetName == '/SDRAM Sheet/SDRAM_A0' || A.NetName == '/SDRAM Sheet/SDRAM_A1' || A.NetName == '/SDRAM Sheet/SDRAM_A2' || A.NetName == '/SDRAM Sheet/SDRAM_A3' || A.NetName == '/SDRAM Sheet/SDRAM_A4' || A.NetName == '/SDRAM Sheet/SDRAM_A5' || A.NetName == '/SDRAM Sheet/SDRAM_A6' || A.NetName == '/SDRAM Sheet/SDRAM_A7' || A.NetName == '/SDRAM Sheet/SDRAM_A8' || A.NetName == '/SDRAM Sheet/SDRAM_A9' || A.NetName == '/SDRAM Sheet/SDRAM_BA0' || A.NetName == '/SDRAM Sheet/SDRAM_BA1' || A.NetName == '/SDRAM Sheet/SDRAM_D0' || A.NetName == '/SDRAM Sheet/SDRAM_D1' || A.NetName == '/SDRAM Sheet/SDRAM_D10' || A.NetName == '/SDRAM Sheet/SDRAM_D12' || A.NetName == '/SDRAM Sheet/SDRAM_D13' || A.NetName == '/SDRAM Sheet/SDRAM_D14' || A.NetName == '/SDRAM Sheet/SDRAM_D15' || A.NetName == '/SDRAM Sheet/SDRAM_D2' || A.NetName == '/SDRAM Sheet/SDRAM_D3' || A.NetName == '/SDRAM Sheet/SDRAM_D4' || A.NetName == '/SDRAM Sheet/SDRAM_D5' || A.NetName == '/SDRAM Sheet/SDRAM_D6' || A.NetName == '/SDRAM Sheet/SDRAM_D7' || A.NetName == '/SDRAM Sheet/SDRAM_D8' || A.NetName == '/SDRAM Sheet/SDRAM_D9' || A.NetName == '/SDRAM Sheet/SDRAM_NBL0' || A.NetName == '/SDRAM Sheet/SDRAM_NBL1' || A.NetName == '/STM32H7 Sheet/NRST' || A.NetName == '/STM32H7 Sheet/OSC32_IN' || A.NetName == '/STM32H7 Sheet/OSC32_OUT' || A.NetName == '/STM32H7 Sheet/OSC_25MHz' || A.NetName == '/STM32H7 Sheet/PA0' || A.NetName == '/STM32H7 Sheet/PA1' || A.NetName == '/STM32H7 Sheet/PA10' || A.NetName == '/STM32H7 Sheet/PA11' || A.NetName == '/STM32H7 Sheet/PA12' || A.NetName == '/STM32H7 Sheet/PA13' || A.NetName == '/STM32H7 Sheet/PA14' || A.NetName == '/STM32H7 Sheet/PA15' || A.NetName == '/STM32H7 Sheet/PA2' || A.NetName == '/STM32H7 Sheet/PA4' || A.NetName == '/STM32H7 Sheet/PA5' || A.NetName == '/STM32H7 Sheet/PA6' || A.NetName == '/STM32H7 Sheet/PA7' || A.NetName == '/STM32H7 Sheet/PA8' || A.NetName == '/STM32H7 Sheet/PA9' || A.NetName == '/STM32H7 Sheet/PB10' || A.NetName == '/STM32H7 Sheet/PB12' || A.NetName == '/STM32H7 Sheet/PB13' || A.NetName == '/STM32H7 Sheet/PB14' || A.NetName == '/STM32H7 Sheet/PB15' || A.NetName == '/STM32H7 Sheet/PB3' || A.NetName == '/STM32H7 Sheet/PB5' || A.NetName == '/STM32H7 Sheet/PB6' || A.NetName == '/STM32H7 Sheet/PB7' || A.NetName == '/STM32H7 Sheet/PC0' || A.NetName == '/STM32H7 Sheet/PC1' || A.NetName == '/STM32H7 Sheet/PC10' || A.NetName == '/STM32H7 Sheet/PC12' || A.NetName == '/STM32H7 Sheet/PC2' || A.NetName == '/STM32H7 Sheet/PC3' || A.NetName == '/STM32H7 Sheet/PC4' || A.NetName == '/STM32H7 Sheet/PC5' || A.NetName == '/STM32H7 Sheet/PC6' || A.NetName == '/STM32H7 Sheet/PC7' || A.NetName == '/STM32H7 Sheet/PC8' || A.NetName == '/STM32H7 Sheet/PD0' || A.NetName == '/STM32H7 Sheet/PD1' || A.NetName == '/STM32H7 Sheet/PD10' || A.NetName == '/STM32H7 Sheet/PD14' || A.NetName == '/STM32H7 Sheet/PD15' || A.NetName == '/STM32H7 Sheet/PD8' || A.NetName == '/STM32H7 Sheet/PD9' || A.NetName == '/STM32H7 Sheet/PE0' || A.NetName == '/STM32H7 Sheet/PE1' || A.NetName == '/STM32H7 Sheet/PE10' || A.NetName == '/STM32H7 Sheet/PE11' || A.NetName == '/STM32H7 Sheet/PE12' || A.NetName == '/STM32H7 Sheet/PE13' || A.NetName == '/STM32H7 Sheet/PE14' || A.NetName == '/STM32H7 Sheet/PE15' || A.NetName == '/STM32H7 Sheet/PE2' || A.NetName == '/STM32H7 Sheet/PE4' || A.NetName == '/STM32H7 Sheet/PE5' || A.NetName == '/STM32H7 Sheet/PE6' || A.NetName == '/STM32H7 Sheet/PE7' || A.NetName == '/STM32H7 Sheet/PE8' || A.NetName == '/STM32H7 Sheet/PE9' || A.NetName == '/STM32H7 Sheet/PF0' || A.NetName == '/STM32H7 Sheet/PF1' || A.NetName == '/STM32H7 Sheet/PF10' || A.NetName == '/STM32H7 Sheet/PF11' || A.NetName == '/STM32H7 Sheet/PF12' || A.NetName == '/STM32H7 Sheet/PF13' || A.NetName == '/STM32H7 Sheet/PF14' || A.NetName == '/STM32H7 Sheet/PF15' || A.NetName == '/STM32H7 Sheet/PF2' || A.NetName == '/STM32H7 Sheet/PF3' || A.NetName == '/STM32H7 Sheet/PF4' || A.NetName == '/STM32H7 Sheet/PF5' || A.NetName == '/STM32H7 Sheet/PF6' || A.NetName == '/STM32H7 Sheet/PF7' || A.NetName == '/STM32H7 Sheet/PF8' || A.NetName == '/STM32H7 Sheet/PF9' || A.NetName == '/STM32H7 Sheet/PG0' || A.NetName == '/STM32H7 Sheet/PG1' || A.NetName == '/STM32H7 Sheet/PG10' || A.NetName == '/STM32H7 Sheet/PG11' || A.NetName == '/STM32H7 Sheet/PG13' || A.NetName == '/STM32H7 Sheet/PG15' || A.NetName == '/STM32H7 Sheet/PG4' || A.NetName == '/STM32H7 Sheet/PG5' || A.NetName == '/STM32H7 Sheet/PG6' || A.NetName == '/STM32H7 Sheet/PG7' || A.NetName == '/STM32H7 Sheet/PG8' || A.NetName == '/STM32H7 Sheet/PH13' || A.NetName == '/STM32H7 Sheet/PH14' || A.NetName == '/STM32H7 Sheet/PH15' || A.NetName == '/STM32H7 Sheet/PH5' || A.NetName == '/STM32H7 Sheet/PH6' || A.NetName == '/STM32H7 Sheet/PH7' || A.NetName == '/STM32H7 Sheet/SDRAM_SDNCAS' || A.NetName == '/STM32H7 Sheet/SDRAM_SDNE1')")
 (constraint via_diameter (min 0.45mm))
 (constraint hole_size (min 0.20mm))
)

(rule "U2 unused data clearance"
 (condition "A.NetName == 'Net-*U2-DQ*' || B.NetName == 'Net-*U2-DQ*'")
 (constraint clearance (min 0.127mm))
)

(rule "SDRAM clock spacing retained"
 (condition "A.NetName == '/STM32H7 Sheet/SDRAM_SDCLK' || B.NetName == '/STM32H7 Sheet/SDRAM_SDCLK'")
 (constraint clearance (min 0.25mm))
)

# Use the existing fabrication minimum for MAX10 BGA escape vias.
(rule "MAX10 BGA via minimum"
 (condition "A.Type == 'Via' && A.intersectsArea('MAX10_BGA_ESCAPE')")
 (constraint via_diameter (min 0.40mm))
 (constraint hole_size (min 0.15mm))
)
